APP_NAME="Adinn Design Task Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=public
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

ZOHO_ACCESS_TOKEN=

# Admin -> Daily Reporting nightly mail API (leave empty until the endpoint exists)
DAILY_REPORT_MAIL_API_URL=

# Admin -> Task Monitoring -> Daily Report -> Live Excel (Google Sheets service-account key; default storage/app/google/service-account.json)
# GOOGLE_SHEETS_CREDENTIALS=

# Browser desktop notifications (Web Push) — generate with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:automation@adinn.co.in

# Shared inspection password for bd/designer/designer_head (never admin). Set with: php artisan auth:set-master-password
MASTER_LOGIN_PASSWORD_HASH=

# Mobile push (Firebase Cloud Messaging, see config/fcm.php). Leave empty to disable.
FCM_PROJECT_ID=
FCM_CREDENTIALS=
FCM_CREDENTIALS_JSON=

# Mobile in-app update gate (see config/app_update.php). Builds = the number after "+" in mobile/pubspec.yaml.
APP_MIN_BUILD=0
APP_LATEST_BUILD=0
APP_LATEST_VERSION=
APP_APK_URL=
# Show "Get the app" (BD + Designer) and serve the published APK. Keep false until the app is released.
APP_DOWNLOAD_ENABLED=true
APP_UPDATE_NOTES=

# Forgot-password OTP mail (deploy/mail-api/password_reset_otp_mail.php). Leave the URL empty to send via MAIL_* instead.
PASSWORD_RESET_MAIL_API_URL=
PASSWORD_RESET_MAIL_API_TOKEN=
